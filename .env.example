# Postgres connection. Locally: Homebrew Postgres. Staging/production: EdBridge's Supabase (London).
DATABASE_URL="postgresql://postgres@localhost:5432/edbridge_dev"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Payload CMS (website editor at /cms). Generate with: openssl rand -base64 32
PAYLOAD_SECRET=""

# AES-256-GCM keys for stored form answers, 32 bytes base64 (openssl rand -base64 32).
# Safeguarding has its own key (PLAN.md §10). Losing a key makes its records unreadable — back them up in EdBridge's password manager.
INTAKE_ENCRYPTION_KEY=""
SAFEGUARDING_ENCRYPTION_KEY=""

# Cloudflare Turnstile for the public forms. These are Cloudflare's always-pass test keys for local
# development; staging and production need real keys from EdBridge's Cloudflare account. Without a
# secret, public forms refuse every submission.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Supabase Storage for CMS images (S3 protocol). Leave blank locally: images are stored in ./media instead.
# Endpoint: https://<project-ref>.storage.supabase.co/storage/v1/s3 · region: eu-west-2
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional: staff alert emails via Resend. Without a key, alerts are logged instead of sent.
RESEND_API_KEY=""
ALERT_EMAIL_FROM="EdBridge Africa <alerts@edbridgeafrica.org>"

# Optional public settings
NEXT_PUBLIC_SITE_URL="https://edbridgeafrica.org"
NEXT_PUBLIC_PAYSTACK_DONATE_URL=""
